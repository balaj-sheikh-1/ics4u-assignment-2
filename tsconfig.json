{
  "compilerOptions": {
    "strict": true,
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Aliases */
    "paths": {
      "#ics4u-assignment-scripts/*": ["./.scripts/*"],
      "@ics4u-assignment-02/*": ["./src/*"],
      "@ics4u-assignment-03/*": ["./src/*"],
      "@ics4u-assignment-04/*": ["./src/*"],
      "@ics4u-assignment-05/*": ["./src/*"],
      "@ics4u-summative/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
